<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>GPS Tracker</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>gps_tracker</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Camera Permission for AR Camera Screen -->
	<key>NSCameraUsageDescription</key>
	<string>GPS Tracker uses the camera for AR navigation, live route guidance, and visual direction overlays.</string>

	<!-- Location Permissions -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GPS Tracker uses your location to show live speed, distance, route, and compass direction while you use the app.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>GPS Tracker needs background location access to keep recording your route, distance, speed, and direction when the screen is off or the app is in the background.</string>

	<key>NSLocationAlwaysUsageDescription</key>
	<string>GPS Tracker needs background location access to keep recording your route, distance, speed, and direction when the screen is off or the app is in the background.</string>

	<key>NSLocationDefaultAccuracyReducedUsageDescription</key>
	<string>Precise location helps GPS Tracker calculate accurate speed, distance, route lines, and trip statistics.</string>

	<!-- Motion / Compass Permission -->
	<key>NSMotionUsageDescription</key>
	<string>Motion detection helps GPS Tracker improve compass direction, movement detection, AR stability warnings, and battery optimization while tracking trips.</string>

	<!-- Hardware Capabilities -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>location-services</string>
		<string>gps</string>
	</array>

	<!-- Background Location -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!-- Network / Local Debug Connections -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalConnections</key>
		<true/>
	</dict>

	<!-- App Store Compliance -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>