<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GPS Tracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>gps_tracker</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- 1. Location Permissions (iOS 14+ Compatible) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GPS Tracker requires your location to display your current speed, bearing, and trip distance while you are using the app.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>GPS Tracker needs background access to record your route and stats even when the screen is off or you are using other apps.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>GPS Tracker needs background access to record your route and stats even when the screen is off or you are using other apps.</string>

	<!-- 2. Enable Background Tasks -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>processing</string>
	</array>

	<!-- 3. Network & Map Security -->
	<!-- Removed Arbitrary Loads (Apple Rejection Risk) in favor of HTTPS compliance -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalConnections</key>
		<true/>
	</dict>

	<!-- 4. UI Polish -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<!-- 5. App Store Compliance -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	
	<!-- 6. Motion Permission (Optional but recommended for GpsService) -->
	<key>NSMotionUsageDescription</key>
	<string>Motion detection helps optimize battery usage by pausing GPS updates when your vehicle is stationary.</string>
</dict>
</plist>